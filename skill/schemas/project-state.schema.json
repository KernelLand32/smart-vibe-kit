{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-vibe-kit.local/schemas/project-state-2.0.json",
  "title": "Smart Vibe Kit project state",
  "type": "object",
  "required": ["schema_version", "kit_version", "project", "stage", "charter", "tasks", "next_action", "authorizations", "updated_at"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "kit_version": {"const": "2.0.0"},
    "project": {"type": "string", "minLength": 1},
    "stage": {"enum": ["charter", "execution"]},
    "charter": {
      "type": "object",
      "required": ["accepted"],
      "properties": {"accepted": {"type": "boolean"}},
      "additionalProperties": false
    },
    "tasks": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/task"}},
    "next_action": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["task_id", "instruction"],
          "properties": {
            "task_id": {"type": "string", "pattern": "^[1-9][0-9]*\\.[1-9][0-9]*\\.[1-9][0-9]*$"},
            "instruction": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      ]
    },
    "authorizations": {"type": "array"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": ["id", "title", "status", "depends_on", "human_gate", "artifact", "verification"],
      "properties": {
        "id": {"type": "string", "pattern": "^[1-9][0-9]*\\.[1-9][0-9]*\\.[1-9][0-9]*$"},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["pending", "in_progress", "blocked", "done"]},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "human_gate": {"type": "boolean"},
        "artifact": {"type": "string", "minLength": 1},
        "verification": {"type": "string", "minLength": 1},
        "blocker": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
