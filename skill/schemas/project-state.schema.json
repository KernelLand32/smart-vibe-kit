{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-vibe-kit.local/schemas/project-state-2.1.json",
  "title": "Smart Vibe Kit 2.1 project state",
  "type": "object",
  "required": ["schema_version", "kit_version", "state_revision", "project", "stage", "charter", "tasks", "next_action", "authorizations", "updated_at"],
  "properties": {
    "schema_version": {"const": "2.1"}, "kit_version": {"const": "2.1.0"},
    "state_revision": {"type": "integer", "minimum": 1},
    "project": {"type": "string", "minLength": 1}, "stage": {"enum": ["charter", "execution", "complete"]},
    "charter": {"type": "object", "required": ["accepted"], "properties": {"accepted": {"type": "boolean"}}, "additionalProperties": false},
    "tasks": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/task"}},
    "next_action": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["task_id", "instruction"], "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "instruction": {"type": "string", "minLength": 1}}, "additionalProperties": false}]},
    "authorizations": {"type": "array", "items": {"type": "object", "required": ["task_id", "actor", "reason", "recorded_at", "kind"], "properties": {"task_id": {"$ref": "#/$defs/taskId"}, "actor": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "recorded_at": {"type": "string", "format": "date-time"}, "kind": {"const": "cooperative-human-attestation"}}, "additionalProperties": false}},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "taskId": {"type": "string", "pattern": "^[1-9][0-9]*\\.[1-9][0-9]*\\.[1-9][0-9]*$"},
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "task": {
      "type": "object",
      "required": ["id", "kind", "title", "goal_id", "deliverable_id", "status", "depends_on", "dependency_rationale", "human_gate", "acceptance", "expected_artifacts", "scope_hints", "required_verifiers", "risk", "size_signals", "completion_receipts"],
      "properties": {
        "id": {"$ref": "#/$defs/taskId"}, "kind": {"enum": ["research", "design", "implementation", "migration", "verification", "documentation"]},
        "title": {"type": "string", "minLength": 1}, "goal_id": {"type": "string", "minLength": 1}, "deliverable_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["pending", "in_progress", "blocked", "done", "superseded"]},
        "depends_on": {"$ref": "#/$defs/strings"}, "dependency_rationale": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "human_gate": {"type": "boolean"}, "acceptance": {"$ref": "#/$defs/strings"}, "expected_artifacts": {"$ref": "#/$defs/strings"}, "scope_hints": {"$ref": "#/$defs/strings"}, "required_verifiers": {"$ref": "#/$defs/strings"},
        "risk": {"enum": ["low", "normal", "high"]},
        "size_signals": {"type": "object", "required": ["subsystems", "acceptance_items", "verifier_count", "scope_hints"], "properties": {"subsystems": {"type": "integer", "minimum": 1}, "acceptance_items": {"type": "integer", "minimum": 0}, "verifier_count": {"type": "integer", "minimum": 0}, "scope_hints": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
        "completion_receipts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "blocker": {"type": "string", "minLength": 1}, "no_artifact_reason": {"type": "string", "minLength": 1}, "size_waiver": {"type": "string", "minLength": 1}, "supersedes": {"$ref": "#/$defs/strings"}, "legacy_completion": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
