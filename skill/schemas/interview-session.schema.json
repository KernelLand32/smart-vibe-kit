{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-vibe-kit.local/schemas/interview-session-2.1.json",
  "title": "SVK 2.1 resumable Interview session",
  "type": "object",
  "required": ["schema_version", "kit_version", "session_id", "target", "idea", "status", "sections", "unresolved_questions", "proposal_sha256", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "2.1"}, "kit_version": {"const": "2.1.0"}, "session_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "target": {"type": "string", "minLength": 1}, "idea": {"type": "string", "minLength": 1}, "status": {"enum": ["collecting", "proposal-ready", "scaffolded", "abandoned"]},
    "sections": {"type": "object", "propertyNames": {"enum": ["project", "users", "scope", "constraints", "risk", "plan", "review"]}, "additionalProperties": {"type": "object"}},
    "unresolved_questions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "proposal_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "abandon_reason": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "abandoned"}}}, "then": {"required": ["abandon_reason"]}},
    {"if": {"not": {"properties": {"status": {"const": "abandoned"}}}}, "then": {"not": {"required": ["abandon_reason"]}}}
  ],
  "additionalProperties": false
}
