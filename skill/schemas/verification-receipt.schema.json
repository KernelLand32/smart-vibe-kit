{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-vibe-kit.local/schemas/verification-receipt-2.1.json",
  "title": "SVK 2.1 immutable verification receipt",
  "type": "object",
  "required": ["schema_version", "kit_version", "run_id", "task_id", "verifier_id", "owner", "started_at", "finished_at", "cwd", "argv", "resolved_executable", "exit_code", "timed_out", "expected_exit_codes", "stdout", "stderr", "inputs_before", "inputs_after", "input_changed_during_run", "artifacts", "missing_artifacts", "result"],
  "properties": {
    "schema_version": {"const": "2.1"}, "kit_version": {"const": "2.1.0"}, "run_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_id": {"type": "string"}, "verifier_id": {"type": "string"}, "owner": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"}, "finished_at": {"type": "string", "format": "date-time"},
    "cwd": {"type": "string"}, "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "resolved_executable": {"type": "string"},
    "exit_code": {"type": "integer"}, "timed_out": {"type": "boolean"}, "expected_exit_codes": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
    "stdout": {"$ref": "#/$defs/log"}, "stderr": {"$ref": "#/$defs/log"},
    "inputs_before": {"$ref": "#/$defs/snapshot"}, "inputs_after": {"$ref": "#/$defs/snapshot"}, "input_changed_during_run": {"type": "boolean"},
    "artifacts": {"type": "array", "items": {"type": "object", "required": ["path", "kind", "sha256"], "properties": {"path": {"type": "string"}, "kind": {"enum": ["file", "directory"]}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false}},
    "missing_artifacts": {"type": "array", "items": {"type": "string"}}, "result": {"enum": ["pass", "fail"]}
  },
  "$defs": {
    "log": {"type": "object", "required": ["sha256", "bytes", "truncated"], "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer", "minimum": 0}, "truncated": {"type": "boolean"}}, "additionalProperties": false},
    "snapshot": {"type": "object", "required": ["sha256", "entries"], "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "entries": {"type": "integer", "minimum": 0}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
